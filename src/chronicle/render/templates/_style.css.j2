  /* 两个视角共用的设计令牌与基础组件。改这里，两套报告一起变。 */
  :root{
    --ink:#16151A; --muted:#6E6A63; --faint:#9C978E;
    --line:#E6E2D9; --paper:#FBFAF6; --card:#FFFFFF;
    --add:#1D9E75; --del:#D85A30; --warm:#B4552A;
    --serif:Georgia,"Songti SC","Source Han Serif SC",serif;
    --sans:ui-sans-serif,system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;
    --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{
    margin:0; background:var(--paper); color:var(--ink);
    font-family:var(--sans); font-size:15px; line-height:1.75;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:900px;margin:0 auto;padding:0 28px}
  h1,h2,h3{font-family:var(--serif);font-weight:600;letter-spacing:-.01em;margin:0}
  h1{font-size:clamp(28px,5vw,46px);line-height:1.15}
  h2{font-size:24px;margin-bottom:6px}
  h3{font-size:17px}
  p{margin:0}
  a{color:inherit}
  .num{font-family:var(--mono);font-variant-numeric:tabular-nums}
  .section{padding:64px 0 0}
  .eyebrow{
    font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--faint);font-weight:500
  }
  .lead{color:var(--muted);font-size:14.5px;max-width:62ch}

  /* hero */
  .hero{background:var(--ink);color:#F5F2EA;padding:72px 0 56px;position:relative;overflow:hidden}
  .hero::after{
    content:"";position:absolute;right:-120px;top:-120px;width:420px;height:420px;
    border:1px solid rgba(245,242,234,.07);border-radius:50%;
  }
  .hero .eyebrow{color:#8C877E}
  .hero h1{margin:14px 0 0;color:#F5F2EA}
  .hero .quote{
    font-family:var(--serif);font-size:clamp(16px,2.2vw,20px);line-height:1.65;
    color:#C9C3B6;margin-top:22px;max-width:52ch;font-style:italic
  }
  .hero .meta{margin-top:16px;font-size:12.5px;color:#8C877E;display:flex;gap:14px;flex-wrap:wrap}
  .hero .meta span{display:inline-flex;align-items:center;gap:6px}
  .dot{width:4px;height:4px;border-radius:50%;background:#57534C}
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:2px;margin-top:40px;
    background:rgba(245,242,234,.09);border-radius:10px;overflow:hidden}
  .stat{background:var(--ink);padding:18px 16px}
  .stat dt{font-size:11px;letter-spacing:.1em;color:#8C877E;text-transform:uppercase}
  .stat dd{margin:6px 0 0;font-size:23px;font-family:var(--mono);font-variant-numeric:tabular-nums;color:#F5F2EA}
  .stat dd small{font-size:11.5px;color:#8C877E;margin-left:3px;font-family:var(--sans)}
  .hero-actions{margin-top:28px;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
  .btn{
    appearance:none;border:1px solid rgba(245,242,234,.24);background:transparent;color:#F5F2EA;
    font:inherit;font-size:13px;padding:9px 18px;border-radius:999px;cursor:pointer;
    transition:background .18s,border-color .18s
  }
  .btn:hover{background:rgba(245,242,234,.1);border-color:rgba(245,242,234,.4)}
  .btn-note{font-size:12px;color:#7A766F}

  /* 卡片与提示 */
  .block{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:26px 24px}
  .legend{display:flex;gap:18px;font-size:12px;color:var(--muted);margin:14px 0 4px}
  .legend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:6px;vertical-align:middle}
  .caption{font-size:12px;color:var(--faint);margin-top:12px;line-height:1.6}
  .notice{margin-top:24px;padding:14px 16px;border-left:2px solid var(--warm);
    background:rgba(180,85,42,.04);font-size:12.5px;color:var(--muted);border-radius:0 6px 6px 0}
  .empty{color:var(--faint);font-size:13px;padding:8px 0}
  footer{margin-top:72px;padding:28px 0 60px;border-top:1px solid var(--line);
    font-size:12px;color:var(--faint);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
  .dirs{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px;padding-top:18px;border-top:1px solid var(--line)}
  .dchip{font-size:11.5px;font-family:var(--mono);color:var(--muted);
    background:rgba(22,21,26,.04);padding:3px 9px;border-radius:4px}

  @media (max-width:720px){
    .wrap{padding:0 20px}
    .hero{padding:52px 0 44px}
    .section{padding:48px 0 0}
  }
